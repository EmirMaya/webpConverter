{
  "name": "convertidor-webp",
  "version": "1.0.0",
  "description": "Conversor web y CLI de imágenes a WebP",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "convert": "node ./src/index.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:bundle": "node scripts/verify-worker-bundle.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "fflate": "^0.8.3",
    "heic-convert": "^2.1.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
