# Local development needs no Redis. Never use memory mode on Vercel.
RATE_LIMIT_BACKEND=memory

# Configure these in Vercel (server-only; never NEXT_PUBLIC_*).
# RATE_LIMIT_BACKEND=redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_ID_SECRET=

# Stable across deployments of the same environment; different for Preview/Production.
RATE_LIMIT_PREFIX=webp-studio:development
